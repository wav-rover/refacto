{
  "name": "101-app",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "workspaces": [
    "services/*"
  ],
  "engines": {
    "node": ">=24.13.1"
  },
  "scripts": {
    "dev": "nodemon -L -r dotenv/config -r ts-node/register src/index.ts",
    "dev:no-watch": "node -r dotenv/config -r ts-node/register src/index.ts",
    "test": "npm run test:services",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "test:services": "npm run test --workspaces --if-present",
    "lint": "eslint src services/*/src",
    "lint:deps": "npx dependency-cruiser src services/*/src --config",
    "build:front": "esbuild src/frontend/app.tsx --bundle --minify --outfile=src/static/js/app.js --loader:.tsx=tsx --loader:.ts=ts"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "mysql2": "^3.16.1",
    "react": "^19.2.4",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.4",
    "sqlite3": "^5.1.7",
    "uuid": "^13.0.0",
    "wait-port": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "cross-env": "^7.0.3",
    "dependency-cruiser": "^17.4.3",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "eslint-plugin-jest": "^29.15.0",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^30.2.0",
    "jest-util": "^30.0.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "@isaacs/brace-expansion": "5.0.1",
    "tar": "7.5.16",
    "glob": "11.1.0",
    "test-exclude": "7.0.1",
    "semver": "7.5.2",
    "cross-spawn": "7.0.5",
    "braces": "3.0.3",
    "http-cache-semantics": "4.1.1",
    "minimatch": "10.2.5",
    "picomatch": "4.0.4",
    "ip-address": "10.2.0",
    "socks": "2.8.9"
  }
}
