# Session cookie signing (optional in dev: app falls back to "dev-secret")
# In production, set SESSION_SECRET in your host's environment.
# SESSION_SECRET=your-secret-here

# Login credentials (used by POST /login)
# AUTH_USERNAME=admin
# AUTH_PASSWORD=your-password

# Docker Compose (phase 2 – broker + services)
# Only used by docker compose at the repo root.
# REDIS_URL=redis://redis:6379
